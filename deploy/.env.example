# Copy to the repository root as .env and fill in real values (chmod 600).
# docker-compose.override.yml reads these; anything left unset falls back to the
# default shown there, and the required ones abort `docker compose up`.

# --- Image ---------------------------------------------------------------
# Set by deploy/deploy.sh to the tag it just built. Leave unset to run the
# upstream published image instead of a locally built one.
NEW_API_IMAGE=

# --- Required ------------------------------------------------------------
SQL_DSN=postgresql://root:change_me@postgres:5432/new-api
REDIS_CONN_STRING=redis://:change_me@redis:6379
POSTGRES_PASSWORD=change_me
REDIS_PASSWORD=change_me
# Sign key for sessions and refresh tokens. Without it the app generates a
# random value per process, so every restart logs all users out and multi-node
# deployments cannot share sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Database ------------------------------------------------------------
POSTGRES_USER=root
POSTGRES_DB=new-api
# Optional separate log database.
# LOG_SQL_DSN=postgresql://root:change_me@postgres:5432/new-api-log
# LOG_SQL_DSN=clickhouse://default:change_me@clickhouse:9000/new_api_logs
# LOG_SQL_CLICKHOUSE_TTL_DAYS=30

# --- Application ---------------------------------------------------------
TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=new-api-node-1
# Set to "slave" on every node except the one running scheduled tasks.
# NODE_TYPE=
# Seconds the server waits for in-flight SSE streams before exiting.
# Keep docker-compose.override.yml's stop_grace_period above this value.
SHUTDOWN_TIMEOUT_SECONDS=120

# --- HTTPS / proxy -------------------------------------------------------
# Required once the app sits behind TLS; SESSION_COOKIE_TRUSTED_URL must then
# list every exact HTTPS origin (comma separated, no wildcards or paths).
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_TRUSTED_URL=https://example.com,https://admin.example.com
# Unset trusts loopback/RFC1918/fc00::/7 with a startup warning; "none" trusts
# no proxies; an explicit list replaces the defaults.
# TRUSTED_PROXIES=172.20.0.0/16

# --- Tuning --------------------------------------------------------------
# STREAMING_TIMEOUT=300
# RELAY_IDLE_CONN_TIMEOUT=90
# SYNC_FREQUENCY=60
